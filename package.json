{
  "name": "cf-workers-native",
  "version": "0.1.5",
  "license": "MIT",
  "description": "Bring Cloudflare Workers apps to iOS and Android.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdlabo-dev/cf-workers-native.git"
  },
  "homepage": "https://github.com/rdlabo-dev/cf-workers-native#readme",
  "bugs": {
    "url": "https://github.com/rdlabo-dev/cf-workers-native/issues"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "capacitor",
    "ios",
    "android"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "files": [
    "dist",
    "Package.swift",
    "native/ios/*.swift",
    "native/ios-host/*.swift",
    "native/android/build.gradle",
    "native/android/consumer-rules.pro",
    "native/android/src/main/"
  ],
  "exports": {
    "./ios": {
      "types": "./dist/ios.d.ts",
      "import": "./dist/ios.js"
    },
    "./android": {
      "types": "./dist/android.d.ts",
      "import": "./dist/android.js"
    },
    "./capacitor": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tooling/vite": {
      "types": "./dist/tooling/vite.d.ts",
      "import": "./dist/tooling/vite.js"
    },
    "./shared/contracts": {
      "types": "./dist/shared/contracts/index.d.ts",
      "import": "./dist/shared/contracts/index.js"
    },
    "./shared/contracts/testing": {
      "types": "./dist/shared/contracts/testing.d.ts",
      "import": "./dist/shared/contracts/testing.js"
    },
    "./cloudflare/workers": {
      "types": "./dist/cloudflare/workers/feature.d.ts",
      "import": "./dist/cloudflare/workers/feature.js"
    },
    "./cloudflare/bindings/kv": {
      "types": "./dist/cloudflare/bindings/kv/index.d.ts",
      "import": "./dist/cloudflare/bindings/kv/index.js"
    },
    "./cloudflare/workers/testing": {
      "types": "./dist/cloudflare/workers/contract.d.ts",
      "import": "./dist/cloudflare/workers/contract.js"
    },
    "./cloudflare/bindings/kv/testing": {
      "types": "./dist/cloudflare/bindings/kv/contract.d.ts",
      "import": "./dist/cloudflare/bindings/kv/contract.js"
    },
    "./tooling/esbuild": {
      "types": "./dist/tooling/esbuild.d.ts",
      "import": "./dist/tooling/esbuild.js"
    },
    "./browser/isolated": {
      "types": "./dist/browser/isolated/transport.d.ts",
      "import": "./dist/browser/isolated/transport.js"
    },
    "./cloudflare/apis/types": {
      "types": "./dist/cloudflare/apis/types.d.ts"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-document-assets.mjs && node scripts/build-codecs.mjs && node scripts/build-notices.mjs",
    "test": "vitest run",
    "test:package": "node scripts/test-package.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "release:prepare": "node scripts/prepare-local-release.mjs",
    "release": "np --no-tests --no-publish --branch main"
  },
  "dependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-async-generator-functions": "^8.0.6",
    "@babel/plugin-transform-async-to-generator": "^8.0.1",
    "@rollup/plugin-inject": "^5.0.5",
    "brotli-dec-wasm": "2.3.2",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "memfs": "4.80.0",
    "node-stdlib-browser": "^1.3.1",
    "parse-srcset": "^1.0.2",
    "parse5": "^8.0.1",
    "punycode": "2.3.1",
    "readable-stream": "4.8.0",
    "rollup": "^4.64.9",
    "scrypt-js": "3.0.1",
    "smol-toml": "^1.9.1",
    "string_decoder": "^1.3.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "web-streams-polyfill": "4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "hono": "4.13.13",
    "np": "^12.1.1",
    "prettier": "3.8.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "whatwg-url": "17.3.0"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.0",
    "vite": "^7.3.7"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    }
  },
  "capacitor": {
    "ios": {
      "src": "native/ios"
    },
    "android": {
      "src": "native/android"
    }
  }
}

{
  "name": "workers-capacitor-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "sync": "cap sync",
    "ios": "cap run ios",
    "android": "cap run android",
    "test:browser": "npm run build && vite build --config tests/vite.express.config.ts && npm run build:validation && playwright test --config tests/playwright.config.ts",
    "test:workers": "vitest run --config tests/vitest.config.ts",
    "test:hyperdrive-migration": "node --test tests/experiments/hyperdrive/integration.test.mjs",
    "test:d1-migration": "node --test tests/experiments/d1/integration.test.mjs",
    "build:runtime": "vite build --config tests/fixtures/apps/runtime/vite.config.ts",
    "test:runtime": "npm run build:runtime && playwright test --config tests/playwright.runtime.config.ts",
    "preview:runtime": "vite preview --config tests/fixtures/apps/runtime/vite.config.ts --host 127.0.0.1 --port 4181 --strictPort",
    "test:runtime:dev": "playwright test --config tests/playwright.runtime-dev.config.ts",
    "build:tools": "node tests/scripts/build-tools.mjs",
    "test:build-tools": "vitest run --config tests/vitest.build.config.ts && npm run build:tools && playwright test --config tests/playwright.build-tools.config.ts",
    "build:validation": "vite build --config tests/validation/vite.config.ts",
    "test:native:prepare": "node tests/scripts/prepare-native.mjs",
    "build:native-documents": "node tests/scripts/build-native-documents.mjs",
    "test:documents": "npm run build:native-documents && playwright test --config tests/playwright.documents.config.ts",
    "build:rendering": "vite build --config rendering/vite.config.ts",
    "test:native:package:prepare": "node tests/scripts/prepare-native-package.mjs",
    "test:native:package": "node tests/scripts/run-native-package.mjs",
    "test:upstream:workerd": "vitest run --config tests/vitest.upstream.config.ts",
    "test:upstream:prepare": "node tests/scripts/prepare-upstream.mjs",
    "test:upstream": "node tests/scripts/run-upstream-native.mjs",
    "test:upstream:browser": "vite build --config tests/upstream/hono-jsx-ssr/browser/vite.config.ts && playwright test --config tests/playwright.upstream.config.ts",
    "build:native-network": "node tests/scripts/build-native-network.mjs",
    "test:native:network:server": "node tests/scripts/network-server.mjs",
    "test:native:network": "node tests/scripts/run-native-network.mjs",
    "test:workers:tls": "vitest run --config tests/vitest.tls.config.ts",
    "test:node-inventory": "node --test tests/experiments/node-compat/*.test.mjs",
    "test:runtime:fallback": "vite build --config tests/fixtures/apps/runtime/vite.stream-fallback.config.ts && playwright test --config tests/playwright.stream-fallback.config.ts",
    "test:runtime:fallback:dev": "playwright test --config tests/playwright.stream-fallback-dev.config.ts",
    "test:service-bindings": "node --test tests/experiments/services/integration.test.mjs",
    "test:cloudflare-bindings": "node --test tests/experiments/cloudflare/integration.test.mjs",
    "test:node-completion": "npm run test:node-inventory && node tests/experiments/node-compat/completion-report.mjs",
    "test:node-boundaries": "node --test tests/experiments/node-compat/*.probe.mjs",
    "test:opennext": "node --test tests/opennext/integration.test.mjs && vite build --config tests/opennext/local/vite.config.ts && node tests/opennext/local/esbuild.mjs && node --test tests/opennext/local.test.mjs",
    "test:opennext:split": "vite build --config tests/opennext/split/vite.config.ts && node tests/opennext/split/esbuild.mjs && node --test --test-concurrency=1 tests/opennext/split/*.test.mjs",
    "test:void": "node --test tests/void/integration.test.mjs",
    "test:void:routes": "npm --prefix void run build && node --test tests/void/routes/acceptance.test.mjs",
    "test:upstream:opennext:prepare": "node tests/upstream/opennext/prepare.mjs",
    "test:upstream:opennext": "node --test tests/upstream/opennext/acceptance.test.mjs",
    "test:upstream:opennext:native": "node --test tests/upstream/opennext/native.test.mjs",
    "test:events": "node --test tests/experiments/node-compat/events-baseline.probe.mjs tests/experiments/node-compat/events-surface.probe.mjs tests/experiments/node-compat/events-contracts.probe.mjs",
    "test:events:native:prepare": "node tests/experiments/node-compat/prepare-events-consumer.mjs",
    "test:events:native": "node tests/experiments/node-compat/events-native.mjs",
    "test:node-expansion": "node --test tests/experiments/node-compat/expansion-contracts.probe.mjs",
    "test:node-expansion:native": "node tests/experiments/node-compat/expansion-native.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "cf-workers-native": "file:..",
    "express": "^5.3.0",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "cf": "^1.0.0-beta.17",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261012.0-beta",
    "mysql2": "^3.24.6",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0",
    "ws": "8.21.0"
  }
}
